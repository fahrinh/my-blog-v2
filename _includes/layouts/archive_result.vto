---
layout: layouts/base.vto
bodyClass: body-tag
---

{{ set archive = search.page(`type=archive lang=${lang} pagination.page=1`) }}

<main class="{{ it.bodyClass }}">
  <header class="page-header">
    <h1 class="page-title">{{ title }}</h1>
  </header>
  {{ if archive }}
    <p class="nav-back">
      <a href="{{ archive.url }}">{{ i18n.nav.back }}</a>
    </p>
  {{ /if }}<br>
  {{ include "templates/post-list.vto" { postslist: results } }}
  {{ include "templates/pagination.vto" }}

  <hr>

  <p class="archive-search">{{ i18n.nav.archive_search }}</p>
  <div class="search" id="search"></div>
</main>
